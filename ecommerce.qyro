>>>python:api [fastapi, uvicorn, requests]
from fastapi import FastAPI
from qyro.lib import qyro
import uuid

app = FastAPI()

@app.post("/checkout")
def checkout(cart_id: str):
    order_id = str(uuid.uuid4())
    print(f"[API] Checkout started for {cart_id} -> Order {order_id}")
    qyro.emit("order_created", {"order_id": order_id, "cart_id": cart_id})
    return {"order_id": order_id, "status": "processing"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)

