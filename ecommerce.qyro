>>>python:api [fastapi, uvicorn, pydantic, qyro]
from qyro.lib import qyro
from fastapi import FastAPI
from pydantic import BaseModel

app = FastAPI()

class Order(BaseModel):
    product_id: str
    quantity: int
    user_id: str

@qyro.on("create_order")
def create_order(data: Order):
    """Create a new order"""
    order_id = f"ORD-{len(data.product_id)}"
    qyro.emit("order_created", {
        "order_id": order_id,
        "product_id": data.product_id,
        "quantity": data.quantity,
        "user_id": data.user_id
    })
    return {"order_id": order_id, "status": "created"}

@qyro.on("get_products")
def get_products(data):
    """Get all products"""
    qyro.emit("products_list", {"products": ["product1", "product2"]})
    return {"products": ["product1", "product2"]}

qyro.start()

>>>python:inventory [sqlalchemy, psycopg2, qyro]
from qyro.lib import qyro

@qyro.on("update_stock")
def update_stock(data):
    """Update inventory stock"""
    product_id = data.get("product_id")
    quantity = data.get("quantity")
    
    qyro.emit("stock_updated", {
        "product_id": product_id,
        "quantity": quantity,
        "status": "updated"
    })
    return {"status": "updated"}

qyro.start()

>>>node:payment [express, stripe, qyro-client]
const { qyro } = require('qyro-client');

qyro.on('process_payment', async (data) => {
    const { order_id, amount, currency } = data;
    
    // Process payment...
    qyro.emit('payment_completed', {
        order_id,
        status: 'completed',
        transaction_id: 'TXN-' + Date.now()
    });
});

qyro.start();
