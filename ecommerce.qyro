>>>python:api [fastapi, uvicorn, requests]
from fastapi import FastAPI
from qyro.lib import qyro
import time
import threading

app = FastAPI()

@app.get("/")
def home():
    return {"message": "Ecommerce API Ready"}

@app.post("/order")
def create_order(item_id: str):
    print(f"[API] Received order for {item_id}")
    qyro.emit("order_created", {"item_id": item_id, "user": "user123"})
    return {"status": "order_pending", "item_id": item_id}

# Listen for payment completion
@qyro.on("payment_processed")
def on_payment(data):
    print(f"[API] Order complete for {data.get('item_id')}!")

# Start listener in background
threading.Thread(target=qyro.start, daemon=True).start()

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)

>>>python:inventory
from qyro.lib import qyro
import time

print("[Inventory] Service Started")

@qyro.on("order_created")
def check_inventory(data):
    item_id = data.get("item_id")
    print(f"[Inventory] Checking stock for {item_id}...")
    time.sleep(1) # Simulate DB

    # Reserve stock
    print(f"[Inventory] Stock reserved for {item_id}")
    qyro.emit("inventory_reserved", data)

qyro.start()

>>>node:payment
const qyro = require('qyro');

console.log("[Payment] Service Started");

qyro.on("inventory_reserved", (data) => {
    console.log(`[Payment] Processing payment for item ${data.item_id}...`);

    setTimeout(() => {
        console.log(`[Payment] Payment successful for ${data.item_id}`);
        qyro.emit("payment_processed", { ...data, status: "paid" });
    }, 2000);
});

qyro.start();
