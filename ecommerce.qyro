>>>react:storefront
import React from 'react';
import { useQyro } from 'qyro-client';

export default function Storefront() {
    const { emit } = useQyro();
    return (
        <div className="p-10">
            <h1 className="text-3xl">Qyro Shop</h1>
            <div className="card">
                <h2>Cool Widget</h2>
                <button onClick={() => emit('add_to_cart', { id: 'widget-1' })}>
                    Add to Cart
                </button>
            </div>
        </div>
    );
}
