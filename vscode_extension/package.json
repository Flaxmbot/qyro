{
  "name": "qyro-vscode",
  "displayName": "Qyro Polyglot Runtime",
  "description": "Syntax highlighting, snippets, and language support for Qyro polyglot files",
  "version": "1.0.0",
  "publisher": "qyro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qyro/qyro"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "qyro",
    "polyglot",
    "microservices",
    "docker",
    "python",
    "rust",
    "java",
    "go",
    "typescript"
  ],
  "scripts": {
    "package": "npx @vscode/vsce package --allow-missing-repository",
    "publish": "npx @vscode/vsce publish --allow-missing-repository"
  },
  "contributes": {
    "languages": [
      {
        "id": "qyro",
        "aliases": [
          "Qyro",
          "qyro"
        ],
        "extensions": [
          ".qyro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qyro",
        "scopeName": "source.qyro",
        "path": "./syntaxes/qyro.tmLanguage.json",
        "embeddedLanguages": {
          "source.python": "python",
          "source.js": "javascript",
          "source.ts": "typescript",
          "source.tsx": "typescriptreact",
          "source.rust": "rust",
          "source.java": "java",
          "source.go": "go",
          "source.c": "c",
          "source.cpp": "cpp"
        }
      }
    ],
    "snippets": [
      {
        "language": "qyro",
        "path": "./snippets/qyro.json"
      }
    ]
  }
}