>>>python:model_service [scikit-learn, pandas, numpy]
from qyro.lib import qyro
import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
import time

print("[Model] Training initial model...")
# Dummy training
X = np.array([[1, 1], [1, 2], [2, 2], [2, 3]])
y = np.dot(X, np.array([1, 2])) + 3
reg = LinearRegression().fit(X, y)
print("[Model] Model trained.")

@qyro.on("features_extracted")
def predict(data):
    features = data.get("features")
    req_id = data.get("id")
    print(f"[Model] Predicting for ID: {req_id}")

    # Use pandas just to show usage
    df = pd.DataFrame([features], columns=['f1', 'f2'])
    prediction = reg.predict(df)[0]

    qyro.emit("prediction_ready", {
        "id": req_id,
        "prediction": prediction,
        "timestamp": time.time()
    })

qyro.start()

