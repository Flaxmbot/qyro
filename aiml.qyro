>>>react:dashboard
import React, { useState, useEffect } from 'react';
import { useQyro } from 'qyro-client';

export default function Dashboard() {
    const { on, emit } = useQyro();
    const [predictions, setPredictions] = useState([]);

    useEffect(() => {
        on('prediction_ready', (data) => {
            setPredictions(prev => [...prev, data]);
        });
    }, []);

    const sendData = () => {
        emit('ingest_data', { id: Date.now().toString(), raw_values: [1.5, 2.5] });
    };

    return (
        <div className="p-4 bg-gray-900 text-white h-screen">
            <h1 className="text-2xl font-bold mb-4">AI Prediction Dashboard</h1>
            <button onClick={sendData} className="bg-blue-600 px-4 py-2 rounded">
                Simulate Ingest
            </button>
            <div className="mt-4 space-y-2">
                {predictions.map(p => (
                    <div key={p.id} className="bg-gray-800 p-2 rounded">
                        Prediction: {p.prediction.toFixed(2)}
                    </div>
                ))}
            </div>
        </div>
    );
}
